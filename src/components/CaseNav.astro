---
/* F17: los 6 casos eran callejones sin salida de comparación: cada ficha
   terminaba con el back a /proyectos y sin forma de seguir el recorrido.
   Anterior y siguiente según el orden del portfolio (el orden de
   `caseStudies` en content.ts): la primera ficha no tiene anterior y la
   última no tiene siguiente, sin wrap. */
import { caseStudies } from "../lib/content";

type Props = { current: string };
const { current } = Astro.props;

const orden = Object.keys(caseStudies);
const idx = orden.indexOf(current);
const prev = idx > 0 ? caseStudies[orden[idx - 1]] : null;
const next = idx !== -1 && idx < orden.length - 1 ? caseStudies[orden[idx + 1]] : null;
---

{prev || next ? (
  <div class="mt-6 flex items-start justify-between gap-4">
    {prev ? (
      <a
        href={`/proyectos/${prev.slug}`}
        class="group inline-flex min-w-0 items-center gap-2 text-sm font-semibold text-green hover:text-green-dark"
      >
        <span aria-hidden="true" class="shrink-0">←</span>
        <span class="case-nav__label min-w-0">
          <span class="block text-[0.65rem] font-medium uppercase tracking-[0.2em] text-green/75">Anterior</span>
          <span class="link-ink inline-block max-w-[min(15rem,44vw)] truncate">{prev.title}</span>
        </span>
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
    {next ? (
      <a
        href={`/proyectos/${next.slug}`}
        class="group inline-flex min-w-0 items-center gap-2 text-right text-sm font-semibold text-green hover:text-green-dark"
      >
        <span class="case-nav__label min-w-0">
          <span class="block text-[0.65rem] font-medium uppercase tracking-[0.2em] text-green/75">Siguiente</span>
          <span class="link-ink inline-block max-w-[min(15rem,44vw)] truncate">{next.title}</span>
        </span>
        <span aria-hidden="true" class="shrink-0">→</span>
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
  </div>
) : null}
